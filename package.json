{
    "name": "telegram-reminder-bot",
    "version": "1.0.0",
    "description": "Telegram bot for smart reminders with natural language support",
    "main": "dist/index.js",
    "engines": {
        "node": ">=22 <23"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "nodemon src/index.ts",
        "migrate": "node --require ts-node/register scripts/migrate.ts",
        "lint": "eslint src test scripts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
        "test": "node --require ts-node/register --test test/*.test.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/igor-2012-killer/telegram-reminder-bot.git"
    },
    "keywords": [
        "telegram",
        "bot",
        "reminder",
        "typescript",
        "grammy"
    ],
    "author": "igor-2012-killer",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/igor-2012-killer/telegram-reminder-bot/issues"
    },
    "homepage": "https://github.com/igor-2012-killer/telegram-reminder-bot#readme",
    "dependencies": {
        "@grammyjs/conversations": "^2.1.1",
        "@grammyjs/ratelimiter": "^1.2.1",
        "@prisma/adapter-better-sqlite3": "^6.0.0",
        "@prisma/client": "^7.2.0",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/uuid": "^10.0.0",
        "axios": "^1.13.2",
        "better-sqlite3": "^11.0.0",
        "chrono-node": "^2.9.0",
        "dotenv": "^17.2.3",
        "fluent-ffmpeg": "^2.1.3",
        "form-data": "^4.0.5",
        "grammy": "^1.39.3",
        "luxon": "^3.7.2",
        "openai": "^6.16.0",
        "pino": "^10.2.0",
        "rrule": "^2.8.1",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/luxon": "^3.7.1",
        "@types/node": "^25.0.9",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "nodemon": "^3.1.11",
        "pino-pretty": "^10.3.1",
        "prettier": "^3.10.1",
        "prisma": "^7.2.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0"
    }
}
